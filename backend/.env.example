# Copy to .env and fill in real values
DATABASE_URL="postgresql://banners:banners@localhost:5432/bannersin48?schema=public"
# Secrets: three DIFFERENT 256-bit random values, e.g. `openssl rand -hex 32` each.
# The API refuses to boot (in every NODE_ENV) if one is missing, short, a placeholder
# or reused. Never copy values between environments.
JWT_SECRET=
ADDRESS_TOKEN_SECRET=
DOWNLOAD_URL_SECRET=
# JWT_ISSUER=bannersin48-api
# JWT_AUDIENCE=bannersin48-web

# Exact frontend origins, comma-separated. Required (https) when NODE_ENV=production;
# defaults to http://localhost:3000 and http://127.0.0.1:3000 otherwise.
# CORS_ORIGINS=https://www.example.com
# Set to 1 to also allow https://bannersin48-frontend-*.vercel.app preview deployments.
# ALLOW_PREVIEW_ORIGINS=0
# NODE_ENV=development
PORT=3001

# Seed admin. Defaults to admin@bannersin48.local / ChangeMe123! outside production;
# with NODE_ENV=production both are required and the password must be 16+ characters.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Storage: only the "local" driver is implemented.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage

# V1 orders use manual payment; no payment-provider credentials are accepted.

# FedEx (not enabled in internal V1)
# FEDEX_API_KEY=
# FEDEX_SECRET_KEY=
# FEDEX_ACCOUNT_NUMBER=
