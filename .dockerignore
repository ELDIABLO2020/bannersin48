# Build context for backend/Dockerfile is the repo root. Keep it small and
# never send secrets, local data or build output to the daemon.

.git
.github
.claude
.cursor
.playwright-cli
.vscode
.idea
docs
deploy
**/.DS_Store
**/*.log
**/*.tsbuildinfo

# Secrets / local env
**/.env
**/.env.*

# Dependencies and build output (rebuilt inside the image)
**/node_modules
**/dist
**/build
**/.next
**/out
**/coverage

# Local data and test artifacts. Anchor paths: backend/src/storage and
# backend/src/audit are source directories and must stay in the context.
backend/storage
**/test-results
**/playwright-report

# The frontend is deployed by Vercel; only its manifest is needed so that
# `npm ci` can verify package-lock.json.
frontend/*
!frontend/package.json
