# Copy to .env and fill in real values

# Database
DATABASE_URL="postgresql://banners:banners@localhost:5432/bannersin48?schema=public"

# Backend
# Secrets: three DIFFERENT 256-bit random values, e.g. `openssl rand -hex 32` each.
# The API refuses to boot (in every NODE_ENV) if one is missing, short, a placeholder
# or reused. Never copy values between environments.
JWT_SECRET=
ADDRESS_TOKEN_SECRET=
DOWNLOAD_URL_SECRET=
# JWT_ISSUER=bannersin48-api
# JWT_AUDIENCE=bannersin48-web

# Exact frontend origins, comma-separated. Required (https) when NODE_ENV=production;
# defaults to http://localhost:3000 and http://127.0.0.1:3000 otherwise.
# CORS_ORIGINS=https://www.example.com
# Set to 1 to also allow https://bannersin48-frontend-*.vercel.app preview deployments.
# ALLOW_PREVIEW_ORIGINS=0
# NODE_ENV=development
PORT=3001

# Frontend commerce mode: locked V1 is internal_manual.
NEXT_PUBLIC_COMMERCE_MODE=internal_manual
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# public_live is future-only. A production build in that mode also requires
# live payment/tax enablement and approved HTTPS policy URLs.
# NEXT_PUBLIC_PUBLIC_COMMERCE_ENABLED=0
# LIVE_PAYMENT_ENABLED=0
# LIVE_TAX_ENABLED=0
# PAYMENT_PROVIDER_CONFIGURED=0
# TAX_PROVIDER_CONFIGURED=0
# NEXT_PUBLIC_PRIVACY_POLICY_URL=
# NEXT_PUBLIC_TERMS_POLICY_URL=
# NEXT_PUBLIC_SHIPPING_POLICY_URL=
# NEXT_PUBLIC_CANCELLATION_POLICY_URL=

# Storage: only the "local" driver is implemented. Uploads stream into
# $LOCAL_STORAGE_DIR/.incoming first, so it must be writable (checked at boot).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# Uploads in flight per process (503 + Retry-After beyond), and per-user artwork quota.
# UPLOAD_MAX_CONCURRENCY=4
# ARTWORK_QUOTA_BYTES=2147483648
# ARTWORK_QUOTA_FILES=500
# Public origin of the API, used in signed artwork/label links. Defaults to
# https://$API_DOMAIN, else http://localhost:$PORT; one of the two is required in production.
# PUBLIC_API_URL=https://api.example.com

# FedEx (not enabled in internal V1)
# FEDEX_API_KEY=
# FEDEX_SECRET_KEY=
# FEDEX_ACCOUNT_NUMBER=
